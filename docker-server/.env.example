# Copy to .env and put a secret of your own in it. The server refuses to serve
# without one.
#
#   openssl rand -hex 24
#
# Then open the server once with the secret in the address, and every later
# visit from that device works without it:
#
#   https://your-host:8002/?k=<the value below>
#
# This is one shared secret, not a user system: the server holds one archive and
# belongs to one person. Treat the link the way you treat the archive itself.
TRIMITDOWN_TOKEN=
